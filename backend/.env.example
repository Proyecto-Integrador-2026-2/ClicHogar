# URL de conexión a PostgreSQL
# Ejemplo: postgres://usuario:password@localhost:5432/clichogar
DATABASE_URL=

# Puerto donde escucha el servidor Elysia
PORT=3000

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Nombre de la cookie de sesión (HU2/HU3)
SESSION_COOKIE_NAME=clichogar_session

# Duración de la sesión en segundos (por defecto 7 días)
SESSION_TTL_SECONDS=604800
