# Copia este archivo como `.env` en la raíz de `frontend/` (NO en `src/`).
# Astro solo carga el `.env` de la raíz del proyecto.
# Nunca commitees el `.env` real (está en .gitignore): contiene secretos.

# Llave pública de Clerk (se expone al navegador, debe empezar por PUBLIC_ en Astro)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Llave secreta (solo servidor/middleware, jamás la expongas ni la subas a git)
CLERK_SECRET_KEY=sk_test_...

# URL base del backend Elysia (sin slash final)
PUBLIC_API_URL=http://localhost:3000
