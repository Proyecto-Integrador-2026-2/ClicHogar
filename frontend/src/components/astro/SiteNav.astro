---
import ThemeToggle from './ThemeToggle.astro';
import '../../styles/nav.css';

// Barra superior única del sitio. Su contenido se decide por sesión:
// - con sesión: Panel · Explorar · Publicar · Cerrar sesión
// - sin sesión: Iniciar sesión / Registrarse (CTA contextual)
// `current` solo marca el enlace activo y elige el CTA público; la
// visibilidad real la ajusta `scripts/nav-auth.ts` en el cliente.
type Current =
  | 'home'
  | 'login'
  | 'register'
  | 'dashboard'
  | 'explorar'
  | 'publicar'
  | 'perfil'
  | 'mias'
  | 'detalle'
  | 'calificaciones'
  | 'chat'
  | 'ofertas';

type Props = {
  current?: Current;
};

const { current = 'home' } = Astro.props;

/** Páginas que asumen sesión al pintar (evita el parpadeo del CTA). */
const privada =
  current !== 'home' && current !== 'login' && current !== 'register';

/** `aria-current="page"` solo en los enlaces que existen en la barra. */
const activo = (clave: 'dashboard' | 'explorar' | 'publicar') =>
  current === clave ? 'page' : undefined;

type Cta = { href: string; label: string; clase?: string };

const cta: Cta[] =
  current === 'home'
    ? [
        {
          href: '/login',
          label: 'Iniciar sesión',
          clase: 'ch-nav__link--ghost',
        },
        {
          href: '/register',
          label: 'Registrarse',
          clase: 'ch-nav__link--cta',
        },
      ]
    : current === 'login'
      ? [{ href: '/register', label: 'Crear cuenta' }]
      : [{ href: '/login', label: 'Iniciar sesión' }];
---
<header class="ch-site-nav">
  <div class="ch-site-nav__inner">
    <a class="ch-brand" href="/" aria-label="ClicHogar inicio">
      <img src="/favicon.ico" alt="" width="28" height="28" />
      <span>ClicHogar</span>
    </a>
    <div class="ch-nav__actions">
      <div class="ch-nav__group" data-nav-auth="in" hidden={!privada}>
        <a
          class="ch-nav__link"
          href="/dashboard"
          aria-current={activo('dashboard')}
        >
          Panel
        </a>
        <a
          class="ch-nav__link"
          href="/tareas"
          aria-current={activo('explorar')}
        >
          Explorar
        </a>
        <a
          class="ch-nav__link"
          href="/tareas/nueva"
          aria-current={activo('publicar')}
        >
          Publicar
        </a>
        <button type="button" class="ch-nav__logout" data-logout>
          Cerrar sesión
        </button>
      </div>
      <div class="ch-nav__group" data-nav-auth="out" hidden={privada}>
        {
          cta.map((c) => (
            <a
              class={`ch-nav__link${c.clase ? ` ${c.clase}` : ''}`}
              href={c.href}
            >
              {c.label}
            </a>
          ))
        }
      </div>
      <ThemeToggle />
    </div>
  </div>
</header>
