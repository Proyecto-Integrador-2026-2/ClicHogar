---
import ThemeToggle from './ThemeToggle.astro';
import '../../styles/nav.css';

// Barra superior del sitio (US-003, #127): marca + acción contextual +
// tema. En páginas auth se ofrece la contraria; en `perfil` solo el
// botón de cierre (visible con sesión, ver `scripts/nav-auth.ts`).
// En `home` (landing pública) siempre se muestran Iniciar sesión +
// Registrarse, sin ranuras de sesión ni botón de cierre.
// En `dashboard` hay enlaces a los módulos + botón de cierre.
type Props = {
  current: 'login' | 'register' | 'perfil' | 'home' | 'dashboard';
};

const { current } = Astro.props;
const cta =
  current === 'login'
    ? { href: '/register', label: 'Crear cuenta' }
    : { href: '/login', label: 'Iniciar sesión' };
---
<header class="ch-site-nav">
  <div class="ch-site-nav__inner">
    <a class="ch-brand" href="/" aria-label="ClicHogar inicio">
      <img src="/favicon.ico" alt="" width="28" height="28" />
      <span>ClicHogar</span>
    </a>
    <div class="ch-nav__actions">
      {current === 'perfil' ? (
        <button
          type="button"
          class="ch-nav__logout"
          data-nav-auth="in"
          data-logout
          hidden
        >
          Cerrar sesión
        </button>
      ) : current === 'home' ? (
        <>
          <a class="ch-nav__link ch-nav__link--ghost" href="/login">
            Iniciar sesión
          </a>
          <a class="ch-nav__link ch-nav__link--cta" href="/register">
            Registrarse
          </a>
        </>
      ) : current === 'dashboard' ? (
        <>
          <a class="ch-nav__link" href="/dashboard" aria-current="page">
            Panel
          </a>
          <a class="ch-nav__link" href="/tareas">
            Explorar
          </a>
          <a class="ch-nav__link" href="/tareas/nueva">
            Publicar
          </a>
          <button
            type="button"
            class="ch-nav__logout"
            data-nav-auth="in"
            data-logout
            hidden
          >
            Cerrar sesión
          </button>
        </>
      ) : (
        <a class="ch-nav__link" href={cta.href}>
          {cta.label}
        </a>
      )}
      <ThemeToggle />
    </div>
  </div>
</header>
