---
import LoginIsla from '../components/react/auth/LoginIsla';
import SiteNav from '../components/astro/SiteNav.astro';
import Background from '../components/astro/Background.astro';
import '../styles/register-page.css';

// Página de inicio de sesión (US-002): misma composición y sistema visual
// que `register.astro` (fondo, temas, tokens `ch-`). La isla se hidrata
// solo en el cliente por ClerkJS (ver LoginIsla.tsx).
const publishableKey = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY ?? '';
---
<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión · ClicHogar</title>
    <link rel="icon" href="/favicon.ico?v=6" sizes="any" />
    <script is:inline>
      // Tema inicial antes del primer pintado (evita flash): guardado >
      // sistema > claro. Debe quedarse inline en el <head>.
      try {
        var t = localStorage.getItem('ch-theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        document.documentElement.dataset.theme = t;
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <SiteNav current="login" publishableKey={publishableKey} />
    <Background />

    <main class="ch-page">
      <div class="ch-page__head">
        <h1>Hola de nuevo</h1>
        <p>La red de servicios y microtrabajos más confiable</p>
      </div>
      <LoginIsla client:only="react" publishableKey={publishableKey} />
    </main>

    <script>
      import { initToolsBackground } from '../scripts/tools-background';
      import { initThemeToggle } from '../scripts/theme-toggle';
      initToolsBackground();
      initThemeToggle();
    </script>
  </body>
</html>
