---
import MisOfertasIsla from '../../../components/react/auth/MisOfertasIsla';
import Background from '../../../components/astro/Background.astro';
import SiteNav from '../../../components/astro/SiteNav.astro';
import '../../../styles/register-page.css';

// "Mis ofertas": tareas aceptadas activas y tareas publicadas con sus
// ofertas. Ruta PROTEGIDA por `/dashboard` (ver `src/lib/routes.ts`).
---
<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mis ofertas · ClicHogar</title>
    <link rel="icon" href="/favicon.ico?v=6" sizes="any" />
    <script is:inline>
      // Tema inicial antes del primer pintado (evita flash): guardado >
      // sistema > claro. Debe quedarse inline en el <head>.
      try {
        var t = localStorage.getItem('ch-theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        document.documentElement.dataset.theme = t;
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <SiteNav current="dashboard" />
    <Background />

    <main class="ch-page ch-page--wide">
      <div class="ch-page__head">
        <h1>Mis ofertas</h1>
        <p>Tus tareas aceptadas y las ofertas que han recibido tus tareas</p>
      </div>
      <MisOfertasIsla client:only="react" />
    </main>

    <script>
      import { initToolsBackground } from '../../../scripts/tools-background';
      import { initThemeToggle } from '../../../scripts/theme-toggle';
      import { initNavAuth } from '../../../scripts/nav-auth';
      initToolsBackground();
      initThemeToggle();
      initNavAuth();
      import { initAuthGuard } from '../../../scripts/auth-guard';
      initAuthGuard();
    </script>
  </body>
</html>
