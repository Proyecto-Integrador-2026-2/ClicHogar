---
// Importamos nuestra isla interactiva de React
import RegisterForm from '../components/react/auth/RegisterForm';
---

<!-- Contenedor principal con fondo gris suave para resaltar la tarjeta -->
<main class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md mb-8 text-center">
    <h1 class="text-3xl font-extrabold text-gray-900">
      Bienvenido a Clic Hogar
    </h1>
    <p class="mt-2 text-sm text-gray-600">
      La red de servicios y microtrabajos más confiable
    </p>
  </div>

  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <RegisterForm client:load />
  </div>
</main>