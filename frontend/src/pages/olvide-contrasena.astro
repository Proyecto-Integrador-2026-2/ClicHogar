---
import { OlvideContrasenaIsla } from '../components/react/auth/RecuperacionIslas';
import SiteNav from '../components/astro/SiteNav.astro';
import Background from '../components/astro/Background.astro';
import '../styles/register-page.css';

// Pide el enlace de recuperación de contraseña (mismo sistema visual que login).
---
<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recuperar contraseña · ClicHogar</title>
    <link rel="icon" href="/favicon.ico?v=6" sizes="any" />
    <script is:inline>
      // Tema inicial antes del primer pintado (evita flash): guardado >
      // sistema > claro. Debe quedarse inline en el <head>.
      try {
        var t = localStorage.getItem('ch-theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        document.documentElement.dataset.theme = t;
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <SiteNav current="login" />
    <Background />

    <main class="ch-page">
      <div class="ch-page__head">
        <h1>Recupera tu acceso</h1>
        <p>Te enviaremos un enlace a tu correo</p>
      </div>
      <OlvideContrasenaIsla client:only="react" />
    </main>

    <script>
      import { initToolsBackground } from '../scripts/tools-background';
      import { initThemeToggle } from '../scripts/theme-toggle';
      import { initNavAuth } from '../scripts/nav-auth';
      initToolsBackground();
      initThemeToggle();
      initNavAuth();
    </script>
  </body>
</html>
